---
import { marked } from 'marked';
import Base from '../../../layouts/Base.astro';
import Logo from '../../../components/Logo.astro';
import { getContent } from '../../../lib/content';

const { content } = await getContent();
const guide = content.guides.find((g) => g.slug === Astro.params.slug);
if (!guide) return Astro.redirect('/app#guide');

// Guide bodies come only from the site owner (JSON files or the password-protected admin).
// Raw HTML in them is escaped anyway, so Markdown is the only formatting.
const renderer = new marked.Renderer();
renderer.html = ({ text }) => text.replace(/</g, '&lt;').replace(/>/g, '&gt;');
const html = await marked.parse(guide.body, { renderer, gfm: true });
const others = content.guides.filter((g) => g.slug !== guide.slug);
---

<Base title={`${guide.title} · Leonida 100%`} noindex>
    <header class="top">
        <div class="wrap top-inner">
            <a class="back" href="/app#guide">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 6-6 6 6 6"></path></svg>
                Guide
            </a>
            <Logo href="/app" size={20} />
        </div>
    </header>

    <main class="wrap article">
        <h1>{guide.title}</h1>
        {guide.updated && <p class="meta">Updated {guide.updated}</p>}
        <div class="prose" set:html={html} />

        {others.length > 0 && (
            <nav class="more">
                <h2>More guides</h2>
                {others.map((g) => (
                    <a class="card" href={`/app/guide/${g.slug}`}>
                        <strong>{g.title}</strong>
                        {g.summary && <span>{g.summary}</span>}
                    </a>
                ))}
            </nav>
        )}
        <p><a class="btn" href="/app">Back to the app</a></p>
    </main>
</Base>

<style>
    .top {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(10, 7, 16, 0.85);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
        padding-top: env(safe-area-inset-top);
    }
    .top-inner {
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .back {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: var(--text);
        text-decoration: none;
        font-weight: 600;
        min-height: 44px;
    }
    .article {
        max-width: 720px;
        padding-top: 28px;
    }
    h1 {
        font-size: clamp(40px, 11vw, 64px);
        background: var(--grad);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }
    .meta {
        color: var(--faint);
        font-size: 14px;
        margin-top: 10px;
    }
    .prose {
        font-size: 17px;
        line-height: 1.7;
        margin-top: 20px;
    }
    .prose :global(h2) {
        font-size: 30px;
        margin: 36px 0 12px;
        color: var(--text);
    }
    .prose :global(h3) {
        font-size: 22px;
        margin: 28px 0 10px;
    }
    .prose :global(ul),
    .prose :global(ol) {
        padding-left: 1.3em;
    }
    .prose :global(li) {
        margin: 6px 0;
    }
    .prose :global(li::marker) {
        color: var(--pink);
    }
    .prose :global(strong) {
        color: #fff;
    }
    .prose :global(em) {
        color: var(--teal);
        font-style: normal;
    }
    .prose :global(code) {
        background: var(--surface-2);
        padding: 2px 6px;
        border-radius: 6px;
        font-size: 0.9em;
    }
    .prose :global(blockquote) {
        margin: 16px 0;
        padding: 10px 16px;
        border-left: 3px solid var(--orange);
        background: rgba(255, 154, 61, 0.07);
        border-radius: 0 10px 10px 0;
    }
    .more {
        margin: 48px 0 24px;
        display: grid;
        gap: 10px;
    }
    .more h2 {
        font-size: 24px;
    }
    .more a {
        display: grid;
        gap: 4px;
        text-decoration: none;
        color: var(--text);
    }
    .more span {
        color: var(--muted);
        font-size: 14px;
    }
</style>
