---
import '../styles/globals.css';
import '@fontsource-variable/inter/wght.css';

interface Props {
    title: string;
    description?: string;
}

const { title, description = 'Turn long videos into short, captioned clips for YouTube Shorts, TikTok and Reels with AI.' } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>
    <body class="min-h-screen font-sans text-white antialiased">
        <header class="mx-auto flex max-w-7xl items-center justify-between px-4 py-5 sm:px-8">
            <a href="/" class="flex items-center gap-2 text-lg font-extrabold no-underline">
                <span class="grid size-8 place-items-center rounded-lg bg-accent text-ink">✂</span>
                ClipHeist
            </a>
            <nav class="flex items-center gap-2">
                <a href="/#how" class="hidden px-3 text-sm text-muted no-underline hover:text-white sm:inline">How it works</a>
                <a href="/studio" class="btn-accent !px-4 !py-2 text-sm">Open studio</a>
            </nav>
        </header>
        <main class="mx-auto max-w-7xl px-4 pb-16 sm:px-8"><slot /></main>
        <footer class="mx-auto max-w-7xl px-4 py-8 text-sm text-muted sm:px-8">© {new Date().getFullYear()} ClipHeist</footer>
    </body>
</html>
