# Copy to .env for local development. On Netlify, set these under Site configuration → Environment variables.

# Whop app (Whop dashboard → Developer → your app → OAuth)
WHOP_CLIENT_ID=app_xxxxxxxxxxxxxx
WHOP_CLIENT_SECRET=
# The product members must own (prod_...)
WHOP_PRODUCT_ID=prod_xxxxxxxxxxxxxx
# Recommended: an API key with permission to check member access. Used to re-check access in the background.
WHOP_API_KEY=
# Your public Whop store page (the "Get access" button links here)
WHOP_STORE_URL=https://whop.com/your-store/

# Long random string used to sign login cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Password for /admin
ADMIN_PASSWORD=

# Optional overrides if Whop changes its OAuth endpoints (defaults are in src/lib/whop.ts)
# WHOP_OAUTH_AUTHORIZE_URL=https://api.whop.com/oauth/authorize
# WHOP_OAUTH_TOKEN_URL=https://api.whop.com/oauth/token
# WHOP_OAUTH_USERINFO_URL=https://api.whop.com/oauth/userinfo
# WHOP_OAUTH_SCOPES=openid profile email
# WHOP_API_BASE=https://api.whop.com/api/v1

# Local development only (ignored in production builds): skip Whop login as this fake user id
# DEV_FAKE_USER=user_dev
